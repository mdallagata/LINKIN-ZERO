{
  // Los colores del sitio (src/app/globals.css y $brand en src/app/bootstrap.scss):
  // fondo casi negro, texto hueso, líneas finas y cadetblue solo como acento,
  // como en la página: la pestaña/vista activa subrayada y los botones llenos.
  // Pensado sobre Dark Modern: el fondo del editor y los colores de la sintaxis siguen siendo los del tema.
  "workbench.colorCustomizations": {
    // Generales
    "focusBorder": "#5f9ea0",
    "foreground": "#ecebe6",
    "descriptionForeground": "#a3a29d",
    "widget.border": "#ecebe624",
    "sash.hoverBorder": "#5f9ea0",
    "progressBar.background": "#5f9ea0",
    "textLink.foreground": "#5f9ea0",
    "textLink.activeForeground": "#ecebe6",
    "badge.background": "#5f9ea0",
    "badge.foreground": "#0b0b0b",

    // Barra de título
    "titleBar.activeBackground": "#0b0b0b",
    "titleBar.activeForeground": "#ecebe6",
    "titleBar.inactiveBackground": "#0b0b0b",
    "titleBar.inactiveForeground": "#a3a29d",
    "titleBar.border": "#ecebe624",
    "commandCenter.background": "#151515",
    "commandCenter.foreground": "#a3a29d",
    "commandCenter.activeBackground": "#ecebe61f",
    "commandCenter.activeForeground": "#ecebe6",
    "commandCenter.border": "#ecebe624",

    // Barra de actividad: como el menú del sitio, la vista activa subrayada en cadetblue
    "activityBar.background": "#0b0b0b",
    "activityBar.foreground": "#ecebe6",
    "activityBar.inactiveForeground": "#a3a29d",
    "activityBar.activeBorder": "#5f9ea0",
    "activityBar.border": "#ecebe624",
    "activityBarBadge.background": "#5f9ea0",
    "activityBarBadge.foreground": "#0b0b0b",
    "activityBarTop.foreground": "#ecebe6",
    "activityBarTop.inactiveForeground": "#a3a29d",
    "activityBarTop.activeBorder": "#5f9ea0",

    // Barra lateral y listas
    "sideBar.background": "#0b0b0b",
    "sideBar.foreground": "#ecebe6",
    "sideBar.border": "#ecebe624",
    "sideBarTitle.foreground": "#a3a29d",
    "sideBarSectionHeader.background": "#0b0b0b",
    "sideBarSectionHeader.foreground": "#a3a29d",
    "sideBarSectionHeader.border": "#ecebe624",
    "sideBarActivityBarTop.border": "#ecebe624",
    "list.activeSelectionBackground": "#5f9ea033",
    "list.activeSelectionForeground": "#ecebe6",
    "list.inactiveSelectionBackground": "#ecebe614",
    "list.inactiveSelectionForeground": "#ecebe6",
    "list.hoverBackground": "#151515",
    "list.focusOutline": "#5f9ea0",
    "list.highlightForeground": "#5f9ea0",
    "tree.indentGuidesStroke": "#ecebe624",

    // Pestañas: la activa subrayada en cadetblue, el resto en gris
    "editorGroupHeader.tabsBackground": "#0b0b0b",
    "editorGroupHeader.tabsBorder": "#ecebe624",
    "editorGroup.border": "#ecebe624",
    "tab.activeBackground": "#0b0b0b",
    "tab.activeForeground": "#ecebe6",
    "tab.activeBorder": "#5f9ea0",
    "tab.activeBorderTop": "#0b0b0b",
    "tab.unfocusedActiveBorder": "#ecebe624",
    "tab.unfocusedActiveBorderTop": "#0b0b0b",
    "tab.selectedBorderTop": "#5f9ea0",
    "tab.inactiveBackground": "#0b0b0b",
    "tab.inactiveForeground": "#a3a29d",
    "tab.hoverBackground": "#151515",
    "tab.border": "#0b0b0b",
    "breadcrumb.foreground": "#a3a29d",
    "breadcrumb.focusForeground": "#ecebe6",
    "breadcrumb.activeSelectionForeground": "#5f9ea0",

    // Editor: el fondo donde se escribe (y su línea actual, el margen y el minimapa) queda el de Dark Modern, más claro que el resto
    "editor.foreground": "#ecebe6",
    "editorLineNumber.foreground": "#ecebe659",
    "editorLineNumber.activeForeground": "#ecebe6",
    "editorCursor.foreground": "#5f9ea0",
    "editor.selectionBackground": "#5f9ea055",
    "editor.inactiveSelectionBackground": "#5f9ea02e",
    "editor.selectionHighlightBackground": "#5f9ea026",
    "editor.wordHighlightBackground": "#ecebe61a",
    "editor.findMatchBackground": "#5f9ea080",
    "editor.findMatchHighlightBackground": "#5f9ea033",
    "editorBracketMatch.background": "#5f9ea026",
    "editorBracketMatch.border": "#5f9ea0",
    "editorIndentGuide.background1": "#ecebe614",
    "editorIndentGuide.activeBackground1": "#ecebe640",
    "editorWhitespace.foreground": "#ecebe626",
    "editorRuler.foreground": "#ecebe614",
    "editorOverviewRuler.border": "#ecebe614",
    "scrollbarSlider.background": "#ecebe61f",
    "scrollbarSlider.hoverBackground": "#ecebe633",
    "scrollbarSlider.activeBackground": "#5f9ea066",

    // Popups, autocompletado, menús y notificaciones: la superficie de las fotos mientras cargan
    "editorWidget.background": "#151515",
    "editorWidget.border": "#ecebe624",
    "editorSuggestWidget.background": "#151515",
    "editorSuggestWidget.border": "#ecebe624",
    "editorSuggestWidget.selectedBackground": "#5f9ea033",
    "editorSuggestWidget.highlightForeground": "#5f9ea0",
    "editorHoverWidget.background": "#151515",
    "editorHoverWidget.border": "#ecebe624",
    "quickInput.background": "#151515",
    "quickInput.foreground": "#ecebe6",
    "quickInputList.focusBackground": "#5f9ea033",
    "pickerGroup.foreground": "#5f9ea0",
    "pickerGroup.border": "#ecebe624",
    "menu.background": "#151515",
    "menu.foreground": "#ecebe6",
    "menu.selectionBackground": "#5f9ea033",
    "menu.border": "#ecebe624",
    "menu.separatorBackground": "#ecebe624",
    "notifications.background": "#151515",
    "notifications.border": "#ecebe624",
    "notificationCenterHeader.background": "#151515",
    "notificationToast.border": "#ecebe624",

    // Campos y botones: el lleno es el "Contratar" del sitio (cadetblue, hover hueso)
    "input.background": "#151515",
    "input.foreground": "#ecebe6",
    "input.border": "#ecebe624",
    "input.placeholderForeground": "#a3a29d",
    "inputOption.activeBorder": "#5f9ea0",
    "inputOption.activeBackground": "#5f9ea033",
    "dropdown.background": "#151515",
    "dropdown.foreground": "#ecebe6",
    "dropdown.border": "#ecebe624",
    "checkbox.background": "#151515",
    "checkbox.border": "#ecebe624",
    "button.background": "#5f9ea0",
    "button.foreground": "#0b0b0b",
    "button.hoverBackground": "#ecebe6",
    "button.secondaryBackground": "#151515",
    "button.secondaryForeground": "#ecebe6",
    "button.secondaryHoverBackground": "#ecebe624",
    "settings.headerForeground": "#ecebe6",
    "settings.modifiedItemIndicator": "#5f9ea0",

    // Panel y terminal
    "panel.background": "#0b0b0b",
    "panel.border": "#ecebe624",
    "panelTitle.activeForeground": "#ecebe6",
    "panelTitle.activeBorder": "#5f9ea0",
    "panelTitle.inactiveForeground": "#a3a29d",
    "terminal.background": "#0b0b0b",
    "terminal.foreground": "#ecebe6",
    "terminalCursor.foreground": "#5f9ea0",
    "terminal.selectionBackground": "#5f9ea055",

    // Barra de estado: gris sobre negro; en cadetblue solo lo remoto y la depuración
    "statusBar.background": "#0b0b0b",
    "statusBar.foreground": "#a3a29d",
    "statusBar.border": "#ecebe624",
    "statusBar.focusBorder": "#5f9ea0",
    "statusBar.noFolderBackground": "#0b0b0b",
    "statusBar.debuggingBackground": "#5f9ea0",
    "statusBar.debuggingForeground": "#0b0b0b",
    "statusBarItem.hoverBackground": "#ecebe61f",
    "statusBarItem.focusBorder": "#5f9ea0",
    "statusBarItem.remoteBackground": "#5f9ea0",
    "statusBarItem.remoteForeground": "#0b0b0b"
  },
  "window.title": "LINKIN ZERØ${separator}${activeEditorShort}",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnPaste": true,
  "editor.tabSize": 2,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.enable": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "[javascript]": {
    "editor.formatOnType": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.exclude": {
    "**/.next": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/pnpm-lock.yaml": true
  }
}
