{
  "name": "linkin-park-webpage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "pnpm images && next dev -p 3010",
    "build": "pnpm images && next build",
    "start": "next start -p 3010",
    "images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-images.mts",
    "instagram-poster": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/instagram-poster.mts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "deploy": "next build && wrangler deploy",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.168.0"
  }
}
